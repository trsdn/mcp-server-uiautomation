<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>UIAutomationMcp.McpServer</AssemblyName>
    <RootNamespace>UIAutomationMcp.McpServer</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UIAutomationMcp.Service\UIAutomationMcp.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".mcp\server.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
