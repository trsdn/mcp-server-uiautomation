<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>UIAutomationMcp.Tests</AssemblyName>
    <RootNamespace>UIAutomationMcp.Tests</RootNamespace>
    <!-- Test methods do not need XML docs, and xunit's own analyzers cover the
         patterns CA rules would otherwise flag in test code. -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1861;CA2007</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UIAutomationMcp.Service\UIAutomationMcp.Service.csproj" />
  </ItemGroup>

</Project>
